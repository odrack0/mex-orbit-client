; mex-orbit-client — el cliente v1 del juego (Godot 4).
; Resolucion logica 1280x720; la UI se dibuja 1:1 (sistema de diseno N).
config_version=5

[application]
config/name="MexOrbit"
run/main_scene="res://ui/login_screen.tscn"
config/features=PackedStringArray("4.4")

[autoload]
Session="*res://net/session.gd"
Quality="*res://game/quality.gd"

[display]
; resolucion logica 1280x720; la ventana arranca MAXIMIZADA y el lienzo se
; estira conservando el aspecto (la UI se ancla a los bordes reales)
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[mexorbit]

; A donde llama el cliente EN ESCRITORIO. En el navegador no se usa: alli la URL
; se deduce del origen de la pagina (ver `net/session.gd::_resolver_api`), que no
; puede quedarse desactualizado el dia que cambie el dominio.
api_base="http://127.0.0.1:5100"

; La ruta de la api DENTRO del mismo origen, en web. Es `/api` porque asi lo
; sirve nginx, y se sirve en el mismo origen a proposito: la api no tiene CORS
; configurado y un navegador bloquearia la llamada entre dominios.
api_path="/api"

[importer_defaults]

; Los mipmaps van ACTIVADOS por defecto, y los atlas los apagan uno a uno en su
; propio .import. Es al reves de como estaba, y el motivo es cual de los dos
; olvidos duele mas: una textura suelta sin mipmaps se aliasa de lejos y nadie
; lo ata a una casilla de importacion, mientras que un atlas con mipmaps se nota
; enseguida —mezcla fotogramas— y ademas su lista es corta y conocida (*-anim).
; Un default seguro con excepciones explicitas, en vez de un default inseguro con
; excepciones que hay que acordarse de poner.
texture={
"mipmaps/generate": true
}

[rendering]
environment/defaults/default_clear_color=Color(0.0275, 0.0275, 0.0588, 1)
